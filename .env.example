# Neon/Postgres — use ?sslmode=require for Neon serverless
DATABASE_URL="postgresql://learnguard:learnguard@localhost:5432/learnguard?schema=public"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard/teacher"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard/teacher"

# Canvas LTI 1.3
LTI_MOCK_MODE="false"
LTI_ISSUER=""
LTI_CLIENT_ID=""
LTI_DEPLOYMENT_ID=""
LTI_PLATFORM_JWKS_URL="https://sso.canvaslms.com/api/lti/security/jwks"
LTI_AUTH_LOGIN_URL="https://sso.canvaslms.com/api/lti/authorize_redirect"
LTI_PUBLIC_JWKS_JSON=""

# Signed LTI session cookie (required in production; dev falls back to CLERK_SECRET_KEY)
LTI_SESSION_SECRET=""
