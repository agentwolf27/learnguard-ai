{
  "name": "learnguard-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "smoke": "node scripts/smoke.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "RUST_LOG=trace prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "RUST_LOG=trace prisma db push",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.2",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "6.19.3",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "next": "15.5.18",
    "openai": "^6.39.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.18",
    "postcss": "^8.5.10",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
